# LLM (Groq)
GROQ_API_KEY=your-groq-api-key
# Optional: default model (e.g. groq/llama-3.1-70b-versatile, groq/llama-3.3-70b-versatile)
# GROQ_MODEL=groq/llama-3.1-70b-versatile

# X / Twitter API v2 — posting uses OAuth 1.0a (Bearer for read-only).
# In developer.x.com: enable OAuth 1.0a in User authentication and set App permissions to "Read and write".
TWITTER_BEARER_TOKEN=your-bearer-token
TWITTER_API_KEY=your-api-key
TWITTER_API_SECRET=your-api-secret
# Optional: same as API Key/Secret (portal may show "Client ID" / "Client Secret" for OAuth 2.0)
# TWITTER_CLIENT_ID=your-client-id
# TWITTER_CLIENT_SECRET=your-client-secret
TWITTER_ACCESS_TOKEN=your-access-token
TWITTER_ACCESS_SECRET=your-access-secret
# Read provider: official (batched API) or xpoz (when implemented). Legacy; prefer PRIMARY/FALLBACK below.
# TWITTER_READ_PROVIDER=official
# Free-first: primary tried first, fallback used on failure/rate limit. Default to rapidapi (free).
# TWITTER_READ_PRIMARY=rapidapi
# TWITTER_READ_FALLBACK=official
# RapidAPI (when TWITTER_READ_PRIMARY=rapidapi or TWITTER_SEARCH_PRIMARY=rapidapi): API key from rapidapi.com
# RAPIDAPI_KEY=your-rapidapi-key
# RAPIDAPI_HOST=twitter-api45.p.rapidapi.com
# RAPIDAPI_CACHE_TTL_SEC=300
# RAPIDAPI_TWITTER_USERNAME=your_twitter_handle
# Xpoz (when TWITTER_READ_PRIMARY=xpoz): API key from xpoz.ai/settings; optional username for follower count
# XPOZ_API_KEY=your-xpoz-api-key
# XPOZ_TWITTER_USERNAME=your_twitter_handle
# Search: same idea. Default to rapidapi (free), fallback to official (paid).
# TWITTER_SEARCH_PRIMARY=rapidapi
# TWITTER_SEARCH_FALLBACK=official
# Optional: max tweet IDs per performance ingestion run (e.g. 30 to stay under 1500/month free tier)
# PERFORMANCE_INGESTION_MAX_TWEETS=50

# Publishing quality and frequency controls
# PUBLISHING_INTERVAL_HOURS=4  # Hours between publishing runs (default: 4, was 1)
# PUBLISHING_LIMIT_PER_RUN=1  # Max posts per publishing run (default: 1, was 5)
# MIN_QUALITY_SCORE=7.0  # Minimum quality score (0-10) to publish (default: 7.0)
# MIN_TIME_BETWEEN_POSTS_MINUTES=60  # Minimum minutes between posts (default: 60)

# Persona: if set, bootstrap will auto-apply this config when the DB persona is empty (e.g. persona_mila.json)
# PERSONA_CONFIG_PATH=persona_mila.json

# Database (default SQLite for MVP)
DATABASE_URL=sqlite:///./atg_engine.db
# Production (Railway/Fly): set DATABASE_URL in the platform's env vars (e.g. Supabase URI), not in a committed file.

# ---- Supabase (Dashboard: https://supabase.com/dashboard → your project) ----
# Project URL (Settings → API → Project URL)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Anon/public key (Settings → API → Project API keys → anon public)
# SUPABASE_ANON_KEY=your-anon-key
# Service role key - server only, bypasses RLS (Settings → API → service_role secret); never expose in client
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Database connection (Settings → Database → Connection string → URI). Use Session pooler (port 6543) for serverless.
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Or direct (port 5432): postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# URL-encode special characters in password: [ ] ! / # @ % etc.

# Optional: local PostgreSQL (no Supabase)
# DATABASE_URL=postgresql://user:pass@localhost:5432/atg_engine
